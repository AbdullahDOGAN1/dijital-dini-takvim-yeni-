<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/risale_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/risale_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bugünün Risale-i Nur"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/risale_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Yükleniyor..."
        android:textColor="#F5F5F5"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/risale_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Risale-i Nur"
        android:textColor="#B2DFDB"
        android:textSize="10sp"
        android:textStyle="italic"
        android:gravity="end" />

</LinearLayout>
